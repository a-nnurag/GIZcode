PORT=8787

# Generate with: openssl rand -hex 32
SESSION_SECRET=replace-with-a-random-32-byte-hex-string

# Comma-separated list of origins allowed to mint a session token / call the API.
ALLOWED_ORIGINS=http://localhost:5173,https://a-nnurag.github.io

# Chatbot: get a free key at https://console.groq.com
GROQ_API_KEY=
# Optional override of the default chat model.
# CHAT_MODEL=openai/gpt-oss-120b

# Chatbot vector store: create a free index at https://console.upstash.com — pick an index
# with an embedding model attached (Dense, e.g. text-embedding-3-small) so Upstash embeds
# the raw text we send it; no separate embeddings API key needed.
UPSTASH_VECTOR_REST_URL=
UPSTASH_VECTOR_REST_TOKEN=
